#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig EXAMPLES_VELAPOKA
	tristate "VelaPoka visual assembly terminal"
	default n
	depends on DRIVERS_VIDEO
	depends on GRAPHICS_LVGL
	depends on LV_USE_IMAGE
	depends on LV_USE_NUTTX
	depends on LV_USE_NUTTX_TOUCHSCREEN
	---help---
		Build the VelaPoka LVGL product application.  It captures packed
		RAW10 frames from the V4L2 camera, converts them to a grayscale live
		preview and renders the split-screen touch UI.

if EXAMPLES_VELAPOKA

config EXAMPLES_VELAPOKA_PRIORITY
	int "VelaPoka task priority"
	default 100

config EXAMPLES_VELAPOKA_STACKSIZE
	int "VelaPoka task stack size"
	default 16384

config EXAMPLES_VELAPOKA_FB_DEVPATH
	string "Framebuffer device path"
	default "/dev/fb0"

config EXAMPLES_VELAPOKA_INPUT_DEVPATH
	string "Touchscreen device path"
	default "/dev/input0"

config EXAMPLES_VELAPOKA_CAMERA_DEVPATH
	string "Camera device path"
	default "/dev/video0"

config EXAMPLES_VELAPOKA_CAMERA_PRIORITY
	int "Camera capture thread priority"
	default 110

config EXAMPLES_VELAPOKA_CAMERA_STACKSIZE
	int "Camera capture thread stack size"
	default 8192

config EXAMPLES_VELAPOKA_PREVIEW_GAIN
	int "RAW10 preview gain"
	range 1 16
	default 4
	---help---
		Multiply the high eight bits of each RAW10 Bayer sample by this
		value before clipping it to the grayscale preview range.

endif # EXAMPLES_VELAPOKA
