#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig EXAMPLES_VELAPOKA
	tristate "VelaPoka visual assembly terminal"
	default n
	depends on DRIVERS_VIDEO
	depends on GRAPHICS_LVGL
	depends on LV_USE_IMAGE
	depends on LV_USE_NUTTX
	depends on LV_USE_NUTTX_TOUCHSCREEN
	depends on NET && NET_TCP
	select NET_SOCKOPTS
	select NET_TCPBACKLOG
	select NETUTILS_NETLIB
	---help---
		Build the VelaPoka LVGL product application.  It captures packed
		RAW10 frames from the V4L2 camera, converts them to a grayscale live
		preview, renders the split-screen touch UI and provides read-only
		Ethernet HTTP export.

if EXAMPLES_VELAPOKA

config EXAMPLES_VELAPOKA_PRIORITY
	int "VelaPoka task priority"
	default 100

config EXAMPLES_VELAPOKA_STACKSIZE
	int "VelaPoka task stack size"
	default 16384

config EXAMPLES_VELAPOKA_FB_DEVPATH
	string "Framebuffer device path"
	default "/dev/fb0"

config EXAMPLES_VELAPOKA_INPUT_DEVPATH
	string "Touchscreen device path"
	default "/dev/input0"

config EXAMPLES_VELAPOKA_CAMERA_DEVPATH
	string "Camera device path"
	default "/dev/video0"

config EXAMPLES_VELAPOKA_CAMERA_PRIORITY
	int "Camera capture thread priority"
	default 110

config EXAMPLES_VELAPOKA_CAMERA_STACKSIZE
	int "Camera capture thread stack size"
	default 8192

config EXAMPLES_VELAPOKA_PREVIEW_GAIN
	int "RAW10 preview gain"
	range 1 16
	default 4
	---help---
		Multiply the high eight bits of each RAW10 Bayer sample by this
		value before clipping it to the grayscale preview range.

config EXAMPLES_VELAPOKA_STORAGE_DEVPATH
	string "MicroSD block device path"
	default "/dev/mmcsd0"

config EXAMPLES_VELAPOKA_STORAGE_MOUNTPOINT
	string "MicroSD FAT mount point"
	default "/mnt/sdcard"

config EXAMPLES_VELAPOKA_STORAGE_PRIORITY
	int "Storage worker priority"
	default 90

config EXAMPLES_VELAPOKA_STORAGE_STACKSIZE
	int "Storage worker stack size"
	default 4096

config EXAMPLES_VELAPOKA_NETWORK_PORT
	int "HTTP export port"
	range 1 65535
	default 8080
	depends on NET && NET_TCP

config EXAMPLES_VELAPOKA_NETWORK_PRIORITY
	int "HTTP export worker priority"
	default 85
	depends on NET && NET_TCP

config EXAMPLES_VELAPOKA_NETWORK_STACKSIZE
	int "HTTP export worker stack size"
	default 6144
	depends on NET && NET_TCP

config EXAMPLES_VELAPOKA_NETWORK_IPADDR
	hex "Ethernet static IPv4 address"
	default 0x0a000002
	depends on NET && NET_TCP
	---help---
		Static IPv4 address for eth0 in host byte order.  The default is
		10.0.0.2.

config EXAMPLES_VELAPOKA_NETWORK_NETMASK
	hex "Ethernet IPv4 netmask"
	default 0xffffff00
	depends on NET && NET_TCP

config EXAMPLES_VELAPOKA_NETWORK_ROUTER
	hex "Ethernet IPv4 router"
	default 0x0a000001
	depends on NET && NET_TCP

endif # EXAMPLES_VELAPOKA
