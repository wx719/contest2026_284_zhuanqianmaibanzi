-/****************************************************************************
- * Name: esp_os_intr_free
- *
- * Description:
- *   Free an interrupt handler.
- *
- * Input Parameters:
- *   handle - Interrupt handle.
- *
- * Returned Value:
- *   ESP_ERR_NOT_SUPPORTED with the legacy NuttX interrupt allocator.
- *
- ****************************************************************************/
+static int esp_os_intr_adapter(int irq, FAR void *context, FAR void *arg)
+{
+  FAR esp_os_intr_handle_t *handle = arg;
+
+  if (handle->status_reg == 0 ||
+      (*(volatile uint32_t *)(uintptr_t)handle->status_reg &
+       handle->status_mask) != 0)
+    {
+      handle->handler(handle->arg);
+    }
+
+  return OK;
+}
 
 esp_err_t esp_os_intr_free(intr_handle_t handle)
 {
-  (void)handle;
+  FAR esp_os_intr_handle_t *adapter = (FAR esp_os_intr_handle_t *)handle;
 
-  return ESP_ERR_NOT_SUPPORTED;
+  if (adapter == NULL)
+    {
+      return ESP_ERR_INVALID_ARG;
+    }
+
+  up_disable_irq(adapter->irq);
+  irq_detach(adapter->irq);
+  esp_teardown_irq(adapter->source, adapter->cpuint);
+  kmm_free(adapter);
+  return ESP_OK;
+}
+
+/* The ESP timer implementation calls the public interrupt-control API
+ * directly after allocating through esp_os_intr_alloc().  The native IDF
+ * interrupt allocator is not linked on NuttX, so operate on the adapter
+ * handle created above.
+ */
+
+esp_err_t esp_intr_enable(intr_handle_t handle)
+{
+  FAR esp_os_intr_handle_t *adapter = (FAR esp_os_intr_handle_t *)handle;
+
+  if (adapter == NULL)
+    {
+      return ESP_ERR_INVALID_ARG;
+    }
+
+  up_enable_irq(adapter->irq);
+  return ESP_OK;
+}
+
+esp_err_t esp_intr_disable(intr_handle_t handle)
+{
+  FAR esp_os_intr_handle_t *adapter = (FAR esp_os_intr_handle_t *)handle;
+
+  if (adapter == NULL)
+    {
+      return ESP_ERR_INVALID_ARG;
+    }
+
+  up_disable_irq(adapter->irq);
+  return ESP_OK;
 }
 
