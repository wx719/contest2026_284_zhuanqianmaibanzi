--- a/nuttx/src/platform/os.c
+++ b/nuttx/src/platform/os.c
@@ -89,6 +89,29 @@
 
 #define OS_PORT_MAX_DELAY 0xfffffffful
 
+struct nuttx_intr_handle_s
+{
+  struct irq_adpt adapter;
+  FAR volatile uint32_t *statusreg;
+  uint32_t statusmask;
+  int source;
+  int irq;
+  int cpuint;
+};
+
+static int esp_os_isr_adapter(int irq, FAR void *context, FAR void *arg)
+{
+  FAR struct nuttx_intr_handle_s *handle = arg;
+
+  if (handle->statusreg == NULL ||
+      ((*handle->statusreg & handle->statusmask) != 0))
+    {
+      handle->adapter.func(handle->adapter.arg);
+    }
+
+  return OK;
+}
+
 /****************************************************************************
  * Private Types
  ****************************************************************************/
@@ -355,9 +378,20 @@
 
 esp_err_t esp_os_intr_free(intr_handle_t handle)
 {
-  (void)handle;
+  FAR struct nuttx_intr_handle_s *nuttx_handle =
+    (FAR struct nuttx_intr_handle_s *)handle;
 
-  return ESP_ERR_NOT_SUPPORTED;
+  if (nuttx_handle == NULL)
+    {
+      return ESP_ERR_INVALID_ARG;
+    }
+
+  up_disable_irq(nuttx_handle->irq);
+  irq_detach(nuttx_handle->irq);
+  esp_teardown_irq(nuttx_handle->source, nuttx_handle->cpuint);
+  kmm_free(nuttx_handle);
+
+  return ESP_OK;
 }
 
