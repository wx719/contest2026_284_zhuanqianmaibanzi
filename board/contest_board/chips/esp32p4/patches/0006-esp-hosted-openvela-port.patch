+
+static void *hosted_thread_trampoline(void *arg)
+{
+	struct hosted_thread_start_s *start = arg;
+	void (*entry)(void const *arg) = start->entry;
+	void *entry_arg = start->arg;
+
+	hosted_free(start);
+	entry(entry_arg);
+	return NULL;
+}
+
+static int hosted_sem_wait(sem_t *sem, int timeout, bool seconds)
+{
+	if (timeout == HOSTED_NON_BLOCKING) {
+		return nxsem_trywait(sem);
+	}
+
+	if (timeout < 0 || (uint32_t)timeout == HOSTED_BLOCK_MAX) {
+		return nxsem_wait_uninterruptible(sem);
+	}
+
+	return nxsem_tickwait_uninterruptible(sem,
+		seconds ? SEC2TICK(timeout) : timeout);
+}
